{
  "extends": ["stylelint-config-standard-scss"],
  "rules": {
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "use",
          "include",
          "forward",
          "mixin",
          "content",
          "function",
          "return",
          "if",
          "else",
          "each",
          "for",
          "while",
          "extend",
          "at-root",
          "debug",
          "warn",
          "error"
        ]
      }
    ]
  },
  "customSyntax": "postcss-scss"
}
